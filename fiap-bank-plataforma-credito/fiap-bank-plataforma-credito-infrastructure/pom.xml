<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.bank</groupId>
        <artifactId>fiap-bank-plataforma-credito</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiap-bank-plataforma-credito-infrastructure</artifactId>
    <packaging>jar</packaging>

    <name>FIAP Bank - Plataforma de Credito - Infrastructure</name>

    <dependencies>
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-plataforma-credito-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>infraestrutura-sem-camadas-superiores</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>br.com.fiap.bank:fiap-bank-plataforma-credito-application</exclude>
                                        <exclude>br.com.fiap.bank:fiap-bank-plataforma-credito-presentation</exclude>
                                    </excludes>
                                    <message>A infraestrutura nao deve depender das camadas Application ou Presentation.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
