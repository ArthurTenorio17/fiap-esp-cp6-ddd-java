/* FIAP BANK - INTERNET BANKING */

:host {
  display: block;
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  color: #f8fafc;
  background: #050b19;
}

* {
  box-sizing: border-box;
}

.mobile-frame {
  width: 100%;
  max-width: 480px;
  min-height: 100vh;
  margin: 0 auto;
  background: #091426;
  color: #f8fafc;
  overflow: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 22px;
  font-size: 13px;
}

.brand-logo {
  width: 48px;
  height: 48px;
  border-radius: 15px;
  background: #e71953;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 800;
}

.brand-title {
  font-size: 27px;
  font-weight: 800;
  letter-spacing: 1px;
  margin: 12px 0;
}

.brand-title span {
  color: #ed2559;
}

/* LOGIN */

.login-container {
  min-height: calc(100vh - 60px);
  padding: 70px 30px 40px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.login-container h2 {
  font-size: 26px;
  margin: 10px 0 0;
}

.login-container p {
  color: #a9b8cd;
  line-height: 1.6;
}

.login-container form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 15px;
}

.input-label {
  font-size: 14px;
  font-weight: 600;
}

.custom-input,
input,
select,
textarea {
  width: 100%;
  padding: 13px 14px;
  background: #14233a;
  color: white;
  border: 1px solid #34455e;
  border-radius: 10px;
  font: inherit;
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: #ed2559;
}

.submit-btn {
  width: 100%;
  padding: 15px;
  border: 0;
  border-radius: 12px;
  background: #e71953;
  color: white;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.submit-btn:hover {
  background: #c91245;
}

.submit-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* CONTEUDO PRINCIPAL */

.main-content,
.content,
.dashboard-content {
  padding: 20px;
}

header,
.header,
.app-header {
  padding: 18px 20px;
}

h1,
h2,
h3,
h4 {
  line-height: 1.3;
}

h2 {
  font-size: 22px;
}

h3 {
  font-size: 18px;
}

p {
  line-height: 1.5;
}

/* CARDS */

.card,
.balance-card,
.credit-card,
.product-card,
.account-card,
.info-card,
.summary-card,
.transaction-card,
.status-card {
  background: #14243b;
  border: 1px solid #263952;
  border-radius: 18px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.15);
}

.balance-card {
  background: linear-gradient(135deg, #182e50, #0c1930);
  padding: 24px;
}

.balance-card h2,
.balance-card .balance-value {
  font-size: 29px;
  font-weight: 800;
}

.balance-card p {
  color: #c3d0df;
}

/* BOTOES E NAVEGACAO */

button {
  font-family: inherit;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

button:hover:not(:disabled) {
  filter: brightness(1.08);
}

button:active:not(:disabled) {
  transform: scale(0.98);
}

.quick-actions,
.action-buttons,
.actions-grid,
.navigation-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0;
}

.quick-actions button,
.action-buttons button,
.actions-grid button,
.navigation-actions button {
  min-height: 75px;
  padding: 12px;
  background: #172a46;
  color: white;
  border: 1px solid #304563;
  border-radius: 14px;
  font-weight: 600;
}

.bottom-nav,
.bottom-navigation,
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 6px;
  padding: 12px 8px;
  background: #101e33;
  border-top: 1px solid #263952;
}

.bottom-nav button,
.bottom-navigation button,
.navbar button {
  flex: 1;
  background: transparent;
  border: none;
  color: #d1d9e6;
  padding: 10px 4px;
  font-size: 12px;
}

/* PRODUTOS DE CREDITO */

.credit-products,
.products-grid,
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 16px 0;
}

.credit-products > *,
.products-grid > *,
.product-grid > * {
  min-width: 0;
}

.product-card {
  margin: 0;
  min-height: 120px;
}

.product-card i {
  color: #ff4473;
  font-size: 22px;
  margin-bottom: 10px;
}

/* FORMULARIOS */

form {
  width: 100%;
}

.form-row {
  display: flex;
  gap: 12px;
}

.form-row > * {
  flex: 1;
  min-width: 0;
}

label {
  display: block;
  margin-bottom: 7px;
}

.primary-btn,
.btn-primary,
.btn-submit {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 14px;
  background: #e71953;
  color: white;
  border: none;
  border-radius: 12px;
  font-weight: 700;
}

/* EXTRATO E HISTORICO */

.transaction-item,
.transaction-row,
.history-item,
.solicitacao-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid #2a3a51;
}

.transaction-item:last-child,
.transaction-row:last-child,
.history-item:last-child,
.solicitacao-item:last-child {
  border-bottom: none;
}

.text-success,
.text-emerald {
  color: #4ade80;
}

.text-danger {
  color: #fb7185;
}

.text-warning,
.text-amber {
  color: #fbbf24;
}

.text-primary {
  color: #8db9ff;
}

/* MENSAGENS */

.alert,
.feedback-message,
.notification {
  padding: 14px;
  border-radius: 12px;
  margin: 12px 0;
  background: #1c304b;
  border: 1px solid #39516f;
}

.badge,
.status-badge {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 20px;
  background: #243955;
  font-size: 12px;
  font-weight: 700;
}

/* RESPONSIVIDADE */

@media (min-width: 700px) {
  .mobile-frame {
    max-width: 520px;
    margin: 25px auto;
    min-height: calc(100vh - 50px);
    border-radius: 22px;
    border: 1px solid #263952;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  }
}

@media (max-width: 400px) {
  .login-container {
    padding: 45px 20px 30px;
  }

  .main-content,
  .content,
  .dashboard-content {
    padding: 15px;
  }

  .brand-title {
    font-size: 24px;
  }
}
